{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PaulinoTech1/Lock_Down/blob/windows-codex/docs/audit11/schemas/validation.schema.json",
  "title": "Lock_Down validation evidence v1",
  "type": "object",
  "required": ["schema", "mode", "expected_kernel", "observed_kernel", "checks", "manual_checklist", "manifest", "summary"],
  "properties": {
    "schema": { "const": "lockdown.validation.v1" },
    "mode": { "enum": ["LIVE_LINUX", "OFFLINE_FIXTURE"] },
    "expected_kernel": { "type": "string" },
    "observed_kernel": { "type": ["string", "null"] },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["check", "status", "reason"],
        "properties": {
          "check": { "type": "string" },
          "status": { "enum": ["PASS", "FAIL", "WARN", "UNKNOWN", "NOT_APPLICABLE", "MANUAL_TEST_REQUIRED"] },
          "reason": { "type": "string" },
          "evidence": { "type": "object" }
        }
      }
    },
    "manual_checklist": { "type": "array", "items": { "type": "string" } },
    "manifest": { "type": "object" },
    "summary": { "type": "object" }
  }
}
