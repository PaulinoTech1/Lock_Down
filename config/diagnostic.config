# diagnostic.config -- FIRST PASS, UNVERIFIED ON HARDWARE
#
# DELTA ONLY. Apply on top of repo/config/hardened.config:
#
#   cp /boot/config-$(uname -r) .config
#   make olddefconfig
#   ./scripts/kconfig/merge_config.sh .config \
#       repo/config/hardened.config repo/config/diagnostic.config
#   make olddefconfig
#
# Every entry below is a deliberate deviation from hardened.config.
# Rationale for each delta lives in docs/HARDENED_VS_DIAGNOSTIC.md;
# nothing here weakens module signing, the LSM stack, lockdown=integrity,
# or the driver allow-list. The diagnostic build is signed with the same
# project key and stays Secure Boot trusted.
#
# Boot-time policy differences (sysctl/kernel cmdline, not Kconfig) are
# listed at the bottom for completeness; they are applied at boot, not
# baked into the image.

# --- 1. ftrace: function and graph tracing for hang/driver diagnosis ---
CONFIG_FUNCTION_TRACER=y
CONFIG_FUNCTION_GRAPH_TRACER=y
CONFIG_STACK_TRACER=y

# --- 2. kprobes/kretprobes/uprobes: targeted dynamic probing ---
CONFIG_KPROBES=y
CONFIG_KRETPROBES=y
CONFIG_UPROBES=y
# Note: under lockdown=integrity some probe sites stay restricted; use
# ftrace on those paths instead of weakening lockdown.

# --- 3. eBPF JIT introspection for debugging eBPF-based diagnosis ---
CONFIG_BPF_JIT=y
# Disassembly of JITed programs while investigating.
# (CONFIG_HAVE_EBPF_JIT is implied by the x86_64 arch; not set here.)

# --- 6. BTF: CO-RE eBPF tooling against this exact kernel ---
CONFIG_DEBUG_INFO_BTF=y
# Requires pahole at build time; build-kernel.sh checks for it.

# --- 8. UBSAN: available only as a one-off investigation build ---
# Left off the standard diagnostic config; enable manually if a specific
# investigation needs it.
# CONFIG_UBSAN is not set

# KASAN and KCSAN are excluded from BOTH profiles, permanently.
# CONFIG_KASAN is not set
# CONFIG_KCSAN is not set

# --- Runtime (boot-time, not Kconfig) differences for a diagnostic session ---
# kernel.perf_event_paranoid=1   (vs 3 on hardened)
# kernel.kptr_restrict=0         (vs 2 on hardened)
# kernel.yama.ptrace_scope=0     (vs 1 on hardened)
# kernel.dmesg_restrict=0        (vs 1 on hardened)
# kernel.sysrq=1                 (vs restricted on hardened)
# debugfs mounted for the session (unmounted on hardened)
# lockdown=integrity             (UNCHANGED; never weakened)
