# hardened.config -- audit9 device/protocol reduction based on audit8
#
# Kconfig fragment for the hardened production kernel, upstream LTS 6.18
# candidate, target: Lenovo ThinkPad T14 Gen 3 Intel (21AJ), i5-1245U
# Alder Lake-U. This is a REDUCTION of a distro baseline, not a minimal
# config: anything the hardware or userspace needs stays.
# Generate from the repository root with:
#   ./scripts/build-kernel.sh --base-config linux-6.18.53/.config
# The script merges this fragment, runs olddefconfig/listnewconfig, and
# rejects missing boot-critical dependencies before compiling.
# Review every resolver change against audit8 and the booted audit7 baseline.
# Audit8 has not yet booted; audit9 must not be installed before that check.
# Conventions: CONFIG_FOO=y enables, "# CONFIG_FOO is not set" disables.
# A short comment above each non-obvious entry explains why.

# --- 64-bit x86 platform base ---
CONFIG_64BIT=y
# Distinguish audit9 from earlier candidates and the working audit7.
CONFIG_LOCALVERSION="-lockdown-t14g3-audit10"
# CONFIG_LOCALVERSION_AUTO is not set
# All 12 logical CPUs must be available on Alder Lake-U.
CONFIG_SMP=y
# CONFIG_MAXSMP is not set
# Keep capacity above the machine's 12 logical CPUs; 64 preserves headroom
# without inheriting the distro's 8192-CPU allocation.
CONFIG_NR_CPUS=64
# EXPERT keeps the x86_64 mmap ASLR entropy controls visible; disabling it
# silently drops the Ubuntu baseline from 32/16 bits to 28/8 bits.
CONFIG_EXPERT=y
CONFIG_ARCH_MMAP_RND_BITS=32
CONFIG_ARCH_MMAP_RND_COMPAT_BITS=16
# Alder Lake is covered by the generic x86_64 CPU selection; no exotic
# subarch. Keep NUMA off: single-socket mobile SoC.
# CONFIG_NUMA is not set
# --- CPU frequency, idle, thermal: Alder Lake-U power path ---
# intel_pstate with HWP/HFI is the only scaling driver; acpi-cpufreq is
# redundant on this CPU and a second policy owner causes oscillation.
CONFIG_X86_INTEL_PSTATE=y
# CONFIG_X86_ACPI_CPUFREQ is not set
CONFIG_INTEL_IDLE=y
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
# HWP remains the hardware policy owner; do not start every boot in the
# performance governor. The live power-policy owner still needs verification.
# CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE is not set
# CONFIG_CPU_FREQ_DEFAULT_GOV_POWERSAVE is not set
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
# Tickless idle and high-resolution timers are the laptop idle baseline.
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y
# CONFIG_NO_HZ_FULL is not set
# Thermal and energy telemetry: Intel RAPL + DTS + HFI.
CONFIG_X86_THERMAL_VECTOR=y
CONFIG_POWERCAP=y
CONFIG_INTEL_RAPL=y
CONFIG_INTEL_HFI_THERMAL=y
CONFIG_X86_CPUID=y
# Early microcode loading via initramfs (microcode 0x43b baseline). The x86
# tree exposes one generic microcode switch for this release.
CONFIG_MICROCODE=y
# --- ACPI ---
CONFIG_ACPI=y
CONFIG_ACPI_BATTERY=y
# ACPI debug tracing is not a production feature.
# CONFIG_ACPI_DEBUG is not set
# CONFIG_ACPI_DEBUGGER is not set
# Battery charge thresholds 75/80% are set via thinkpad_acpi sysfs.
CONFIG_ACPI_VIDEO=y
# --- Graphics: Intel i915 ONLY ---
# Firmware the panel path needs: DMC 2.20 / GuC 70.49.4 / HuC 7.9.3
# lineage (adlp_* blobs, supplied via linux-firmware at initramfs time).
# Explicitly no other GPU vendors: no dGPU on this machine.
# CONFIG_DRM_AMDGPU is not set
# CONFIG_DRM_RADEON is not set
# CONFIG_DRM_NOUVEAU is not set
# KVM host remains; i915 GVT-g mediated GPU sharing is not required.
# CONFIG_DRM_I915_GVT_KVMGT is not set
# This Intel-only laptop has no VIA graphics controller.
# CONFIG_FB_VIA is not set
# CONFIG_FB_VIA_X_COMPATIBILITY is not set
# --- Storage: Samsung PM9A1 NVMe ---
CONFIG_BLK_DEV_NVME=y
CONFIG_NVME_CORE=y
# APST stays enabled (PS4=5mW); never set nvme_core.default_ps_max_latency_us=0.
# LUKS2 + TPM2 + PIN is the planned data-at-rest design; dm-crypt is the
# kernel side of it.
# --- Audio: SOF Intel HDA path + Realtek ALC257 only ---
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_HDA=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_SOF_TOPLEVEL=y
CONFIG_SND_SOC_SOF_PCI=y
CONFIG_SND_SOC_SOF_INTEL_TOPLEVEL=y
CONFIG_SND_HDA_INTEL=y
CONFIG_SND_SOC_SOF_HDA_COMMON=y
CONFIG_SND_HDA_CODEC_REALTEK=y
CONFIG_SND_HDA_CODEC_HDMI=y
CONFIG_SND_HDA_CODEC_HDMI_INTEL=y
CONFIG_SND_SOC_SOF_HDA_LINK=y
CONFIG_SND_SOC_SOF_HDA_AUDIO_CODEC=y
# No AMD ACP/SOF/SoundWire audio hardware exists on this Intel laptop.
# Disable the independent AMD audio families, not just the SOF submenu.
# CONFIG_SND_SOC_AMD_ACP is not set
# CONFIG_SND_SOC_AMD_ACP3x is not set
# CONFIG_SND_SOC_AMD_RENOIR is not set
# CONFIG_SND_SOC_AMD_ACP5x is not set
# CONFIG_SND_SOC_AMD_ACP6x is not set
# CONFIG_SND_AMD_ACP_CONFIG is not set
# CONFIG_SND_SOC_AMD_ACP_COMMON is not set
# CONFIG_SND_SOC_AMD_RPL_ACP6x is not set
# CONFIG_SND_SOC_AMD_ACP63_TOPLEVEL is not set
# CONFIG_SND_SOC_AMD_PS is not set
# CONFIG_SOUNDWIRE_AMD is not set
# CONFIG_SND_SOC_SOF_AMD_TOPLEVEL is not set
# No other codecs or DSP families: nothing else is wired to this board.
# (Broader SND_SOC Intel machine drivers stay at distro default; prune
# only what menuconfig shows as clearly non-present after first boot.)
# --- Input: i8042 keyboard, Elan TrackPoint, Synaptics I2C touchpad ---
CONFIG_SERIO_I8042=y
CONFIG_MOUSE_PS2_ELANTECH=y
CONFIG_I2C_HID_ACPI=y
CONFIG_THINKPAD_ACPI=y
# MSI EC support is for a different laptop family.
# CONFIG_MSI_EC is not set
# The Keyspan remote receiver is absent.
# CONFIG_INPUT_KEYSPAN_REMOTE is not set
# This is a Lenovo; Surface, Acer, Dell, HP, and Apple SMC platform
# interfaces have no matching hardware. Keep ThinkPad ACPI enabled above.
# CONFIG_SURFACE_PLATFORMS is not set
# CONFIG_ACERHDF is not set
# CONFIG_ACER_WIRELESS is not set
# CONFIG_ACER_WMI is not set
# CONFIG_X86_PLATFORM_DRIVERS_DELL is not set
# CONFIG_X86_PLATFORM_DRIVERS_HP is not set
# CONFIG_HP_ILO is not set
# CONFIG_HP_WATCHDOG is not set
# CONFIG_SENSORS_APPLESMC is not set
# thinkpad_acpi owns hotkeys, fan, battery thresholds, rfkill hooks.
# No fingerprint reader and no webcam on this unit: excluded.
# CONFIG_USB_VIDEO_CLASS is not set
# No camera, capture card, TV tuner, radio, SDR, or IR remote is in scope.
# This also removes built-in V4L2/DVB test devices currently creating fake
# video, radio, and touch nodes on audit7. HDMI CEC is a separate path and
# remains enabled for external-display safety.
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_RC_CORE is not set
# --- USB: xHCI host and MediaTek MT7921U Wi-Fi ---
CONFIG_USB_XHCI_HCD=y
CONFIG_USB=y
# No Keyspan serial adapter, EMI26/EMI62 USB audio device, or iSight camera.
# CONFIG_USB_SERIAL_KEYSPAN_PDA is not set
# CONFIG_USB_SERIAL_KEYSPAN is not set
# CONFIG_USB_EMI62 is not set
# CONFIG_USB_EMI26 is not set
# CONFIG_USB_ISIGHTFW is not set
# USB-C display adapters use DisplayPort Alternate Mode via UCSI on this
# machine. HDMI is driven by i915. Keep these paths for external monitors.
CONFIG_TYPEC=y
CONFIG_TYPEC_UCSI=y
CONFIG_UCSI_ACPI=y
CONFIG_TYPEC_DP_ALTMODE=y
CONFIG_PCI_MSI=y
CONFIG_NETDEVICES=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
# Sole network path: external MediaTek MT7921U (0e8d:7961), bus 4 port 1.
CONFIG_MT7921U=y
# The mac80211 simulated-radio test device is not physical Wi-Fi support.
# CONFIG_MAC80211_HWSIM is not set
# Internal AX211 removed: iwlwifi stays out entirely.
# CONFIG_IWLWIFI is not set
# No other Wi-Fi vendors present: Broadcom, Realtek, Atheros all out.
# CONFIG_BRCMFMAC is not set
# CONFIG_RT2X00 is not set
# CONFIG_ATH9K is not set
# CONFIG_ATH10K is not set
# CONFIG_ATH11K is not set
# Optional USB-Ethernet dongles must be built in for this monolithic profile.
CONFIG_USB_USBNET=y
CONFIG_USB_NET_AX8817X=y
CONFIG_USB_NET_AX88179_178A=y
CONFIG_USB_NET_CDCETHER=y
CONFIG_USB_RTL8152=y
# No PCI wired NICs on this machine: the Intel wired vendor block stays off.
# CONFIG_NET_VENDOR_INTEL is not set
# USB4/Thunderbolt PCI tunneling is not part of this profile. Direct USB-C
# DisplayPort Alternate Mode and HDMI remain supported; a Thunderbolt dock
# that requires PCI tunneling is outside the supported monitor path.
# CONFIG_USB4 is not set
# CONFIG_TYPEC_TBT_ALTMODE is not set
# Bluetooth hardware REMOVED: the whole stack stays out.
# CONFIG_BT is not set
# No 802.15.4 hardware exists here. This also removes the fakelb and hwsim
# virtual radios that created unused wpan interfaces and recurring errors.
# CONFIG_IEEE802154 is not set
# CONFIG_MAC802154 is not set
# --- TPM 2.0: Nuvoton discrete, TIS interface ---
CONFIG_TCG_TPM=y
CONFIG_TCG_TIS_CORE=y
CONFIG_TCG_TIS=y
# --- Virtualization: KVM Intel, VT-d, IRQ remap ---
CONFIG_KVM_INTEL=y
CONFIG_KVM=y
# This Intel CPU cannot use the AMD KVM backend.
# CONFIG_KVM_AMD is not set
# No Xen HVM guests are planned; retain ordinary Intel KVM and Hyper-V
# paravirtual interfaces for possible non-Xen guests.
# CONFIG_KVM_XEN is not set
CONFIG_VIRTUALIZATION=y
CONFIG_INTEL_IOMMU=y
CONFIG_IRQ_REMAP=y
CONFIG_INTEL_IOMMU_DEFAULT_ON=y
# IOMMU in enforcing mode; the USB Wi-Fi and any USB dongle sit behind it.
# Namespaces stay: containers/sandboxing depend on them.
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
# --- LSM stack: AppArmor + YAMA + Landlock + lockdown ---
CONFIG_SECURITY=y
CONFIG_SECURITY_APPARMOR=y
CONFIG_SECURITY_YAMA=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_SECURITY_LOCKDOWN_LSM=y
# Force the requested integrity lockdown policy in the kernel image. The
# Ubuntu fallback kernel remains available if this policy blocks a feature.
CONFIG_LOCK_DOWN_KERNEL_FORCE_INTEGRITY=y
# Userspace may still pass: apparmor=1 security=apparmor
# Do not inherit Ubuntu packaging certificate paths that do not exist in the
# upstream kernel source tree used by this build. Secure Boot trust comes from
# the signed image and enrolled platform/MOK key; no loadable modules are used.
CONFIG_SYSTEM_TRUSTED_KEYS=""
CONFIG_SYSTEM_REVOCATION_KEYS=""
# --- Module policy ---
# This profile is deliberately monolithic: there are no loadable modules to
# sign or load after boot. If a modular/DKMS workflow is needed, switch to an
# explicit modular profile with signed initramfs contents instead of assuming
# a force-signing policy can coexist with modules disabled.
# CONFIG_MODULES is not set
# --- Hardening options (rationale in docs/KERNEL_HARDENING.md) ---
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_FORTIFY_SOURCE=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y
CONFIG_INIT_ON_FREE_DEFAULT_ON=y
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_SHUFFLE_PAGE_ALLOCATOR=y
CONFIG_VMAP_STACK=y
CONFIG_RANDOMIZE_BASE=y
CONFIG_RANDOMIZE_MEMORY=y
CONFIG_RANDOMIZE_KSTACK_OFFSET=y
CONFIG_STRICT_KERNEL_RWX=y
CONFIG_MITIGATION_PAGE_TABLE_ISOLATION=y
CONFIG_STRICT_DEVMEM=y
CONFIG_IO_STRICT_DEVMEM=y
# Speculative-execution mitigations: kernel defaults (eIBRS auto-selected
# on Alder Lake); never disabled. No explicit spectre_v2=/retbleed= knobs.
# --- Networking: nftables era ---
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
# No serial-line IP (SLIP) link is used on this USB-Wi-Fi laptop.
# CONFIG_SLIP is not set
# CONFIG_SLIP_COMPRESSED is not set
# CONFIG_SLIP_SMART is not set
# CONFIG_SLIP_MODE_SLIP6 is not set
CONFIG_NF_CONNTRACK=y
CONFIG_NFT_CT=y
CONFIG_NFT_LOG=y
CONFIG_NFT_LIMIT=y
# iptables compatibility kept only if userspace tooling needs it; nftables
# is the configured firewall. CAN, amateur radio, FireWire excluded.
# CONFIG_CAN is not set
# CONFIG_HAMRADIO is not set
# CONFIG_FIREWIRE is not set
# --- Filesystems: only what the install uses ---
CONFIG_VFAT_FS=y
# VFAT is for the EFI System Partition only. BTRFS/XFS decision deferred
# to install time: enable the one the installer actually formats.
# CONFIG_BTRFS_FS is not set
# CONFIG_XFS_FS is not set
# --- Suspend: s2idle only ---
CONFIG_SUSPEND=y
# S3 is not exposed by this firmware generation; s2idle is the suspend path.
# --- Excluded classes ---
# Staging drivers as a class.
# CONFIG_STAGING is not set
# This is a physical Intel laptop and a KVM host, not a Xen/Hyper-V guest.
# Keep the Intel KVM host, Intel IOMMU, VFIO, and vhost paths.
# CONFIG_XEN is not set
# CONFIG_HYPERV is not set
# There is no CXL memory/accelerator, RapidIO fabric, or PCI endpoint
# controller in the live PCI inventory. PCI root-port support remains.
# CONFIG_CXL_BUS is not set
# CONFIG_RAPIDIO is not set
# CONFIG_PCI_ENDPOINT is not set
# The only live MTD devices are mtdram and nandsim test devices; the disk is
# NVMe. Keep the Intel SPI host and EFI ESRT paths for firmware handling.
# CONFIG_MTD is not set
# No built-in PCI Ethernet controller exists. Audit9 also removes USB
# Ethernet; the retained stock kernel remains the alternate-network recovery.
# CONFIG_ETHERNET is not set
# The NVMe disk does not use a SCSI host adapter. This drops PCI HBAs and
# iSCSI/FCoE offload drivers that force Ethernet back on. Keep SCSI core,
# SCSI disk, USB mass-storage and UAS for bootable recovery media.
# CONFIG_SCSI_LOWLEVEL is not set
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
# No SATA/PATA, UFS, MMC, Memory Stick, or RDMA controller is present.
# USB-to-SATA disks use the USB mass-storage/UAS path above instead.
# CONFIG_ATA is not set
# CONFIG_SCSI_UFSHCD is not set
# CONFIG_MMC is not set
# CONFIG_MEMSTICK is not set
# CONFIG_INFINIBAND is not set
# No ISDN or ATM line is attached to this laptop.
# CONFIG_ISDN is not set
# CONFIG_ATM is not set
# The live null-block and NBD entries are unused virtual test devices;
# zram is present but is not active swap. Keep encrypted /swap.img unchanged.
# CONFIG_BLK_DEV_NULL_BLK is not set
# CONFIG_BLK_DEV_NBD is not set
# CONFIG_ZRAM is not set
# ATA-over-Ethernet is unrelated to the local NVMe/USB rescue path.
# CONFIG_ATA_OVER_ETH is not set
# The CPU advertises VMX/EPT/VPID, but not SGX or TDX. Keep Intel KVM while
# excluding unsupported enclave/confidential-VM host paths and the optional
# virtualization-exception debug checker.
# CONFIG_X86_SGX is not set
# CONFIG_INTEL_TDX_HOST is not set
# CONFIG_KVM_INTEL_PROVE_VE is not set
# Only the external MT7921U (0e8d:7961) is the intended WLAN device.
# CONFIG_WLAN_VENDOR_ADMTEK is not set
# CONFIG_WLAN_VENDOR_ATH is not set
# CONFIG_WLAN_VENDOR_ATMEL is not set
# CONFIG_WLAN_VENDOR_BROADCOM is not set
# CONFIG_WLAN_VENDOR_INTEL is not set
# CONFIG_WLAN_VENDOR_INTERSIL is not set
# CONFIG_WLAN_VENDOR_MARVELL is not set
CONFIG_WLAN_VENDOR_MEDIATEK=y
# CONFIG_WLAN_VENDOR_MICROCHIP is not set
# CONFIG_WLAN_VENDOR_PURELIFI is not set
# CONFIG_WLAN_VENDOR_RALINK is not set
# CONFIG_WLAN_VENDOR_REALTEK is not set
# CONFIG_WLAN_VENDOR_RSI is not set
# CONFIG_WLAN_VENDOR_SILABS is not set
# CONFIG_WLAN_VENDOR_ST is not set
# CONFIG_WLAN_VENDOR_TI is not set
# CONFIG_WLAN_VENDOR_ZYDAS is not set
# CONFIG_WLAN_VENDOR_QUANTENNA is not set
# Disallow VFIO's no-IOMMU bypass while retaining supported VM passthrough.
# CONFIG_VFIO_NOIOMMU is not set
# AMD platform drivers: no AMD silicon present.
# CONFIG_AMD_PSTATE is not set
# AMD IOMMU is intentionally disabled on this Intel-only build.
# CONFIG_AMD_IOMMU is not set
# --- Production tracing posture (see docs/HARDENED_VS_DIAGNOSTIC.md) ---
# Static tracepoints stay; dynamic function tracing is out of production.
# EXPERT selects DEBUG_KERNEL, so retaining the stronger ASLR defaults means
# disabling the actual debug interfaces and tracers rather than that umbrella.
# CONFIG_KEXEC_HANDOVER_DEBUGFS is not set
# CONFIG_GPIO_VIRTUSER is not set
# CONFIG_SUNRPC_DEBUG is not set
# CONFIG_BLK_DEV_IO_TRACE is not set
# CONFIG_PUNIT_ATOM_DEBUG is not set
# CONFIG_NOTIFIER_ERROR_INJECTION is not set
# CONFIG_FUNCTION_TRACER is not set
# CONFIG_STACK_TRACER is not set
# CONFIG_DEBUG_FS is not set
# CONFIG_KGDB is not set
# CONFIG_KGDB_KDB is not set
# CONFIG_DYNAMIC_DEBUG is not set
# CONFIG_KPROBES is not set
# BTF off in production.
# CONFIG_DEBUG_INFO_BTF is not set
# Production does not use crash/gdb DWARF; preserve kallsyms for boot
# diagnostics while avoiding a multi-gigabyte debug-symbol package.
CONFIG_DEBUG_INFO_NONE=y
# Sanitizers never ship in production.
# CONFIG_KASAN is not set
# CONFIG_KCSAN is not set
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_RD_ZSTD=y
# Snap uses loop-mounted SquashFS images; these must be built in because this
# profile deliberately has no loadable modules.
CONFIG_BLK_DEV_LOOP=y
CONFIG_BLK_DEV_LOOP_MIN_COUNT=8
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
# The host EFI filesystem requires the CP437 NLS table.
CONFIG_NLS_CODEPAGE_437=y
# linux-firmware is compressed on this host; allow the built-in drivers to
# load the shipped .zst firmware blobs from the initramfs/root filesystem.
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y
# Ubuntu's system module list references autofs4; retain it built in.
CONFIG_AUTOFS_FS=y
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_ESRT=y
CONFIG_FB=y
CONFIG_FB_EFI=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_DRM=y
CONFIG_DRM_I915=y
CONFIG_EXT4_FS=y
# Keep Ubuntu ext4 ACL permissions and security-label xattrs built in.
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_CRYPT=y
CONFIG_CRYPTO_XTS=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_AES_NI_INTEL=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_SHA512=y
CONFIG_CRYPTO_CBC=y
CONFIG_MD=y

# --- Audit9: unneeded device and protocol families ---
# Keep xHCI USB host, HID, mass storage/UAS, and MT7921U. This laptop has no
# physical USB device controller; the audit7 USBIP UDC is virtual only.
# CONFIG_USB_GADGET is not set
# CONFIG_USB_SERIAL is not set
# CONFIG_USB_ACM is not set
# CONFIG_USB_PRINTER is not set
# CONFIG_USB_NET_DRIVERS is not set
# External USB HDMI-CEC adapters select the host ACM driver; neither is
# present. Keep CEC_CORE for the integrated i915 display path.
# CONFIG_USB_PULSE8_CEC is not set
# CONFIG_USB_RAINSHADOW_CEC is not set
# Removing gadget mode otherwise changes these unrelated dual-role host
# controller choices to host-only =y. The observed laptop controllers bind
# xhci_hcd, so remove their parent drivers as well.
# CONFIG_USB_DWC3 is not set
# CONFIG_USB_MUSB_HDRC is not set
# CONFIG_USB_ISP1760 is not set
# CONFIG_USB_ISP1760_HCD is not set
# The SYNA8018:00 touchpad binds hid-multitouch over i2c_hid_acpi, so keep
# that driver even though this laptop has no touchscreen device.
# CONFIG_INPUT_TOUCHSCREEN is not set
CONFIG_HID_MULTITOUCH=y
# These protocols are not required by the MT7921U, the local TCP/IP stack,
# or a conventional Intel KVM guest. Removing VSOCK drops guest-host socket
# integration, not /dev/kvm; verify the intended VM workflow at runtime.
# CONFIG_TIPC is not set
# CONFIG_RDS is not set
# CONFIG_L2TP is not set
# CONFIG_IP_SCTP is not set
# CONFIG_MPTCP is not set
# CONFIG_NFC is not set
# CONFIG_VSOCKETS is not set
# CONFIG_OPENVSWITCH is not set
# CONFIG_MPLS is not set
# CONFIG_N_GSM is not set
# Their independent netfilter, IPVS, and traffic-control helpers otherwise
# remain built-in even after the top-level protocols are disabled.
# tc's connection-tracking action selects two OVS-named netfilter helpers;
# ordinary nftables/libvirt conntrack does not require that tc action.
# CONFIG_NET_ACT_CT is not set
# CONFIG_NF_CONNTRACK_OVS is not set
# CONFIG_NF_NAT_OVS is not set
# CONFIG_NF_CT_PROTO_SCTP is not set
# CONFIG_NETFILTER_XT_MATCH_L2TP is not set
# CONFIG_NETFILTER_XT_MATCH_SCTP is not set
# CONFIG_IP_VS_PROTO_SCTP is not set
# CONFIG_NET_ACT_MPLS is not set
# CONFIG_NET_DSA is not set
# CONFIG_ARCNET is not set
# CONFIG_FDDI is not set
# CONFIG_WAN is not set
# No data-acquisition/industrial-I/O devices, non-Intel GPU, or in-kernel
# header archive is required for this physical host.
# CONFIG_COMEDI is not set
# CONFIG_IIO is not set
# CONFIG_DRM_XE is not set
# CONFIG_DRM_VMWGFX is not set
# CONFIG_DRM_QXL is not set
# CONFIG_DRM_VIRTIO_GPU is not set
# CONFIG_DRM_BOCHS is not set
# CONFIG_DRM_CIRRUS_QEMU is not set
# CONFIG_IKHEADERS is not set
# The active LSM list is lockdown, Landlock, Yama, AppArmor, IMA, and EVM.
# Keep those and drop compiled-but-inactive alternate policy providers.
# CONFIG_SECURITY_SELINUX is not set
# CONFIG_SECURITY_SMACK is not set
# CONFIG_SECURITY_TOMOYO is not set
# CONFIG_SECURITY_IPE is not set
# CONFIG_SECURITY_SAFESETID is not set

# --- Audit10: USB specialty, test, and legacy storage bridge drivers ---
# Preserve xHCI host, HID, generic mass storage, UAS, and MT7921U Wi-Fi.
# These unsupported specialty devices and test fixtures are hotplug probes.
# CONFIG_USB_YUREX is not set
# CONFIG_USB_LEGOTOWER is not set
# CONFIG_USB_IDMOUSE is not set
# CONFIG_USB_MDC800 is not set
# CONFIG_USB_CYTHERM is not set
# CONFIG_USB_ADUTUX is not set
# CONFIG_USB_LD is not set
# CONFIG_USB_TRANCEVIBRATOR is not set
# CONFIG_USB_LCD is not set
# CONFIG_USB_IOWARRIOR is not set
# CONFIG_USB_SISUSBVGA is not set
# CONFIG_USB_MICROTEK is not set
# CONFIG_USB_APPLEDISPLAY is not set
# CONFIG_USB_TEST is not set
# CONFIG_USB_EHSET_TEST_FIXTURE is not set
# CONFIG_USB_LINK_LAYER_TEST is not set
# Model-specific bridge/card-reader helpers are unsupported; generic USB
# storage/UAS remains. Some legacy devices will lose special functionality.
# CONFIG_USB_STORAGE_ALAUDA is not set
# CONFIG_USB_STORAGE_DATAFAB is not set
# CONFIG_USB_STORAGE_ENE_UB6250 is not set
# CONFIG_USB_STORAGE_FREECOM is not set
# CONFIG_USB_STORAGE_ISD200 is not set
# CONFIG_USB_STORAGE_JUMPSHOT is not set
# CONFIG_USB_STORAGE_KARMA is not set
# CONFIG_USB_STORAGE_ONETOUCH is not set
# CONFIG_USB_STORAGE_SDDR09 is not set
# CONFIG_USB_STORAGE_SDDR55 is not set
# CONFIG_USB_STORAGE_USBAT is not set
# CONFIG_USB_STORAGE_CYPRESS_ATACB is not set
